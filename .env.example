# ============ PortFlow 环境变量示例（复制为 .env 后填写真实值，.env 已被 .gitignore 排除） ============

# --- 后端敏感配置（勿提交真实值）---
# DeepSeek AI API Key（未配置时自动降级为 Mock 规则实现）
AI_DEEPSEEK_API_KEY=sk-你的key

# sa-token JWT 签名密钥（生产环境必须设置）
SA_TOKEN_SECRET=你的随机密钥

# Pexels 图片搜索 API Key（可选，配置后可启用 Pexels 降级搜索）
PEXELS_API_KEY=

# MySQL 连接（与 docker-compose 默认一致）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio
DB_USER=root
DB_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- image-crawler 图片爬虫 HTTP API 服务 ---
# 启动方式：cd image-crawler && python server.py --port 8120
IMAGE_CRAWLER_API_URL=http://127.0.0.1:8120
